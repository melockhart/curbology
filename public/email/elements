  body { margin:0; padding:0; width:100% !important; background:#e9edf2; }
  table { border-collapse:collapse; }
  img { border:0; outline:none; text-decoration:none; -ms-interpolation-mode:bicubic; }
  a { color:#1a202c; }

  /* Outlook cannot render the webfont, so give it the fallback explicitly
     rather than letting it guess at a variable font it half-recognises. */
