  /*
   * The real brand faces, served from Curbology's own domain rather than
   * Google's — no third-party dependency in a message that may be read years
   * from now, and the same files the site already ships.
   *
   * Apple Mail, iOS Mail, Outlook for Mac and Thunderbird load these. Everything
   * else falls to the stack behind them, which is why Georgia sits behind
   * Fraunces (both high-contrast serifs) and Helvetica behind Instrument Sans.
   * The layout must look deliberate either way — it is a fallback, not a
   * degradation.
   */
  @font-face {
    font-family: 'Fraunces';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('https://curbology.op-site.net/fonts/fraunces.woff2') format('woff2');
  }
  @font-face {
