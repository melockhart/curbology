<style>
  /* Every colour is baked literally. Outlook does not support CSS custom
     properties, so a var() here renders as no colour at all. */
  body { margin:0; padding:0; width:100% !important; background:#f2f4f7; }
  table { border-collapse:collapse; }
  img { border:0; outline:none; text-decoration:none; -ms-interpolation-mode:bicubic; }
  a { color:#1a202c; }
  .well a { color:#1a202c; }
  @media only screen and (max-width:620px) {
    .shell { width:100% !important; }
    .pad { padding-left:20px !important; padding-right:20px !important; }
    .stack { display:block !important; width:100% !important; }
  }
</style>
</head>
<body style="margin:0;padding:0;background:#f2f4f7;">
<div style="display:none;font-size:1px;color:#f2f4f7;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;">Preheader text</div>

