    <table role="presentation" class="shell" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:600px;">
      <tr><td class="pad" style="padding:24px 32px;border-top:1px solid #d9dee5;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#4a5568;">
        Internal — Curbology operations. Not for forwarding to customers.
